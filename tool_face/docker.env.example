# Đổi tên thành ".env" và đặt cạnh docker-compose.yml trên máy chủ. KHÔNG đưa file này lên Git.
# Điền giá trị thật ở máy chủ, không gửi cho ai.

# Bắt buộc, dài >= 32 ký tự. Nếu copy database cũ sang thì dùng ĐÚNG giá trị SESSION_SECRET cũ
# (token Fanpage được mã hóa bằng khóa này).
SESSION_SECRET=

# Địa chỉ công khai của tool, https, không có dấu / ở cuối
CLIENT_ORIGIN=https://tool.example.com
BACKEND_URL=https://tool.example.com
COOKIE_SECURE=true

# Đặt true tạm thời để tạo tài khoản đầu tiên, tạo xong đặt lại false
ALLOW_REGISTER=true
# id số của tài khoản admin (tài khoản đầu tiên thường là 1)
FACEBOOK_ADMIN_IDS=1

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://tool.example.com/api/auth/facebook/callback

USE_SQLITE=true
POLL_COMMENTS=on
MESSENGER_VERIFY_TOKEN=
