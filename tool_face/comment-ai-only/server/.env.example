NODE_ENV=production
PORT=5000

# SQLite là mặc định, giống cấu hình đang dùng của app hiện tại.
USE_SQLITE=true
# Mặc định lưu ở server/data/tool_face.sqlite.
# Đặt APP_DATA_DIR thành thư mục chứa tool_face.sqlite để dùng database cũ.
APP_DATA_DIR=

# Chỉ dùng SQL Server khi đặt USE_SQLITE=false và điền đủ thông tin bên dưới.
DB_SERVER=your-sql-server-host
DB_PORT=1433
DB_NAME=your-database
DB_USER=your-database-user
DB_PASSWORD=replace-with-a-strong-password
DB_ENCRYPT=true
DB_TRUST_CERT=false

# Đặt ADMIN_PASSWORD khi cần khởi tạo tài khoản admin đầu tiên.
# Tối thiểu 8 ký tự; không dùng mật khẩu mặc định khi chạy production.
ADMIN_PASSWORD=replace-with-at-least-8-characters
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECURE=true

# URL public của giao diện. API và callback OAuth dùng chung domain qua /api.
CLIENT_ORIGIN=https://your-domain.example
FACEBOOK_REDIRECT_URI=https://your-domain.example/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FB_GRAPH_VERSION=v19.0
FB_VERIFY_TOKEN=replace-with-a-random-webhook-verify-token

# AI mặc định. Có thể dùng cấu hình ai_api_key/ai_model/ai_base_url
# trong SystemSettings của database hiện có thay cho các biến này.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_BASE_URL=https://api.openai.com/v1
