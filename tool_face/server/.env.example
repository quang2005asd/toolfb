CLIENT_ORIGIN=http://localhost:3000
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/auth/facebook/callback
FACEBOOK_LOGIN_SCOPES=public_profile
# Phân quyền nằm trong bảng AppUsers (role admin / manager / user).
# Tài khoản Admin mặc định được tạo tự động: admin | 1 — hãy đổi mật khẩu sau lần đăng nhập đầu tiên.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Hộp thư Messenger + Instagram Direct (token Fanpage cần quyền pages_messaging, instagram_manage_messages)
# Chu kỳ tự đồng bộ tin nhắn và trả lời tự động (giây, tối thiểu 3), đặt 0 để tắt
MESSENGER_SYNC_INTERVAL_SECONDS=5
# Webhook nhận tin tức thì (chỉ dùng khi deploy có domain HTTPS):
# Callback URL = https://<domain>/api/webhooks/messenger, Verify Token = giá trị dưới đây, cần FACEBOOK_APP_SECRET
MESSENGER_VERIFY_TOKEN=
COOKIE_SECURE=false

# ========================================================
# 1. KẾT NỐI DATABASE (HỖ TRỢ CẢ LOCAL LẪN CLOUD)
# ========================================================
# --- [CHẾ ĐỘ A: CHẠY TRÊN MÁY TÍNH CỦA BẠN (LOCAL WINDOWS)] ---
DB_SERVER=localhost
DB_NAME=tool_face_db
# Nếu dùng Windows Authentication thì để trống DB_USER & DB_PASSWORD
DB_USER=
DB_PASSWORD=

# --- [CHẾ ĐỘ B: KHI TRIỂN KHAI LÊN CLOUD (AZURE SQL / RENDER)] ---
# DB_MODE=cloud
# DB_SERVER=your-azure-db.database.windows.net
# DB_NAME=tool_face_db
# DB_USER=your_db_username
# DB_PASSWORD=your_db_password
# DB_PORT=1433
# DB_ENCRYPT=true
# DB_TRUST_CERT=false

# ========================================================
# 2. KẾT NỐI REDIS (HÀNG ĐỢI ĐĂNG BÀI BULLMQ)
# ========================================================
# Mặc định Local (Chạy qua Docker):
REDIS_HOST=localhost
REDIS_PORT=6379

# Khi chạy Cloud (Upstash Redis miễn phí):
# REDIS_URL=rediss://default:your_password@your-upstash-host.upstash.io:6379

# ========================================================
# 3. CHẾ ĐỘ WORKER GỘP (TIẾT KIỆM TIỀN TRÊN RENDER)
# ========================================================
# Đặt = true khi đưa lên Render để chạy Web và Worker chung 1 tiến trình:
# RUN_WORKER_IN_PROCESS=true

# ========================================================
# 4. KIỂM SOÁT TẢI UPLOAD TIKTOK (CHỐNG QUÁ TẢI SERVER)
# ========================================================
# Số browser Chromium (Puppeteer) được phép chạy CÙNG LÚC.
# Mỗi browser tiêu tốn ~300-500MB RAM. Khuyến nghị:
#   - RAM 2GB  → 1
#   - RAM 4GB  → 2 (mặc định)
#   - RAM 8GB+ → 3-4
# Các job vượt quá giới hạn sẽ tự động xếp hàng chờ.
TIKTOK_MAX_CONCURRENT_BROWSERS=2

# Thời gian chờ tối thiểu (mili-giây) giữa 2 lần upload từ CÙNG 1 tài khoản TikTok.
# Giúp tránh TikTok phát hiện hành vi spam / bất thường.
# 60000 = 1 phút (mặc định). Tăng lên nếu bị TikTok chặn.
TIKTOK_ACCOUNT_RATE_LIMIT_MS=60000