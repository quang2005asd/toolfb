# ========================================================
# Cấu hình chạy thật trên VPS — sao chép thành .env rồi điền:  cp .env.production.example .env
# Tạo chuỗi ngẫu nhiên:  openssl rand -hex 32
# KHÔNG đưa file .env lên Git / gửi cho người khác.
# ========================================================

# Tên miền đã trỏ bản ghi A về IP của VPS (không có https://, không có / cuối)
DOMAIN=ten-mien-cua-ban.com

# Khóa ký phiên đăng nhập + mã hóa token Facebook. Đặt một lần, KHÔNG đổi sau khi đã kết nối Fanpage
SESSION_SECRET=

# Mật khẩu tài khoản admin (tối thiểu 8 ký tự). Thay mật khẩu mặc định "1" ngay lần khởi động đầu tiên
ADMIN_PASSWORD=

# Chuỗi tự đặt, nhập giống hệt vào Meta App → Webhooks → Verify token
MESSENGER_VERIFY_TOKEN=

# Meta App (có thể để trống và nhập trong trang Cài đặt → Meta App của tool)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FB_GRAPH_VERSION=v26.0
# Chỉ xin những quyền tool thực sự dùng (App Review dễ được duyệt hơn)
FACEBOOK_LOGIN_SCOPES=public_profile,pages_show_list,pages_read_engagement,pages_read_user_content,pages_manage_posts,pages_manage_engagement,pages_manage_metadata,pages_messaging,business_management,instagram_basic,instagram_manage_messages

# Thông tin hiện trên trang Chính sách quyền riêng tư / Điều khoản / Xóa dữ liệu (Meta bắt buộc)
PUBLIC_APP_NAME=Tool Face
PUBLIC_OPERATOR_NAME=
PUBLIC_CONTACT_EMAIL=
# Ngày cập nhật chính sách (YYYY-MM-DD), để trống = 2026-10-12
PUBLIC_POLICY_UPDATED_AT=

# Chu kỳ tự đồng bộ hộp thư (giây). Đã cấu hình webhook thì có thể tăng lên 30 để giảm gọi API
MESSENGER_SYNC_INTERVAL_SECONDS=5

# AI Bình luận: on = quét bình luận mới mỗi 2 phút (ngoài webhook feed); giãn cách giữa 2 lần trả lời (ms)
POLL_COMMENTS=on
REPLY_MIN_GAP_MS=6000
# Thông báo khách tiềm năng qua Telegram (tùy chọn, có thể nhập trong trang Cài đặt)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
